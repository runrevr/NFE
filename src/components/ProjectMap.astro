---
/**
 * §9.4 — the interactive project map, drawn by hand.
 *
 * No tile service and no map library: the site has to work offline and makes no
 * third-party requests, so the ground is an inline SVG of simplified state
 * outlines and every pin is projected from the `coords` already stored in
 * company.ts. Nothing here is a claim about NFE — the only project facts on the
 * page (name, owner, location, headline, slug) come straight from that module.
 *
 * The state outlines and the bounding box are map furniture, deliberately
 * stylised. They are a locator, not a survey.
 *
 * Markup is authored finished: the pins, the leader lines and the full project
 * list are all in the DOM at build time. The script only subtracts initial
 * states (when motion is allowed) and swaps which job card is showing.
 */
import { projects } from "../data/company";

type LonLat = readonly [number, number];

/** Fixed bounding box: the Inland Northwest down to the Sawtooths. */
const BOUNDS = { west: -125, east: -110, south: 42, north: 49 } as const;

const VIEW_W = 960;
/**
 * A degree of longitude is shorter than a degree of latitude, by cos(lat). One
 * correction at the box's mid-latitude sets the drawing's aspect ratio so the
 * states do not read stretched; the mapping itself stays linear.
 */
const MID_LAT_SCALE = Math.cos(
  (((BOUNDS.south + BOUNDS.north) / 2) * Math.PI) / 180,
);
const VIEW_H = Math.round(
  (VIEW_W * (BOUNDS.north - BOUNDS.south)) /
    ((BOUNDS.east - BOUNDS.west) * MID_LAT_SCALE),
);

/** Pure: [longitude, latitude] to the 0–1 unit square of the bounding box. */
function projectLonLat([lon, lat]: LonLat) {
  return {
    fx: (lon - BOUNDS.west) / (BOUNDS.east - BOUNDS.west),
    fy: (BOUNDS.north - lat) / (BOUNDS.north - BOUNDS.south),
  };
}

/** The same mapping, expressed in SVG user units. */
function toSvg(coords: LonLat) {
  const { fx, fy } = projectLonLat(coords);
  return { x: fx * VIEW_W, y: fy * VIEW_H };
}

const ring = (points: readonly LonLat[]) =>
  points
    .map(toSvg)
    .map(({ x, y }, i) => `${i ? "L" : "M"}${x.toFixed(1)} ${y.toFixed(1)}`)
    .join(" ") + " Z";

/* Simplified state boundaries, clockwise, in [lon, lat]. Coarse on purpose. */

const IDAHO: readonly LonLat[] = [
  [-117.04, 49.0], [-116.05, 49.0], [-115.83, 48.4], [-115.55, 47.85],
  [-115.28, 47.42], [-114.95, 46.95], [-114.58, 46.64], [-114.42, 46.15],
  [-114.05, 45.78], [-113.92, 45.68], [-113.45, 45.6], [-113.05, 44.95],
  [-112.8, 44.62], [-112.3, 44.48], [-111.6, 44.55], [-111.05, 44.48],
  [-111.05, 42.0], [-117.03, 42.0], [-117.03, 43.83], [-116.97, 44.24],
  [-117.24, 44.55], [-116.85, 45.0], [-116.72, 45.3], [-116.75, 45.6],
  [-116.92, 45.99], [-117.04, 46.42],
];

const WASHINGTON: readonly LonLat[] = [
  [-124.73, 48.38], [-123.12, 48.15], [-122.82, 48.42], [-122.76, 49.0],
  [-117.04, 49.0], [-117.04, 46.43], [-116.92, 45.99], [-118.99, 45.99],
  [-119.26, 45.93], [-120.5, 45.71], [-121.2, 45.65], [-122.24, 45.55],
  [-122.78, 45.65], [-123.11, 46.15], [-123.88, 46.2], [-124.08, 46.27],
  [-124.06, 46.7], [-124.15, 47.05], [-124.37, 47.55], [-124.63, 47.92],
];

const OREGON: readonly LonLat[] = [
  [-123.96, 46.24], [-123.11, 46.15], [-122.78, 45.65], [-122.24, 45.55],
  [-121.2, 45.65], [-120.5, 45.71], [-119.26, 45.93], [-118.99, 45.99],
  [-116.92, 45.99], [-116.75, 45.6], [-116.72, 45.3], [-116.85, 45.0],
  [-117.24, 44.55], [-116.97, 44.24], [-117.03, 43.83], [-117.03, 42.0],
  [-124.21, 42.0], [-124.4, 42.85], [-124.5, 43.35], [-124.15, 44.05],
  [-124.06, 44.7], [-123.96, 45.5],
];

const STATE_LABELS: ReadonlyArray<{ text: string; at: LonLat }> = [
  { text: "WASHINGTON", at: [-120.4, 47.4] },
  { text: "OREGON", at: [-120.6, 43.8] },
  { text: "IDAHO", at: [-114.6, 44.6] },
];

/* One-degree drafting grid. */
const gridLon: number[] = [];
for (let lon = BOUNDS.west + 1; lon < BOUNDS.east; lon += 1) {
  gridLon.push(toSvg([lon, BOUNDS.north]).x);
}
const gridLat: number[] = [];
for (let lat = BOUNDS.south + 1; lat < BOUNDS.north; lat += 1) {
  gridLat.push(toSvg([BOUNDS.west, lat]).y);
}

/**
 * Half the jobs sit inside one county, so at this scale their marks land on top
 * of each other. Standard plan-sheet answer: leave a tick at the true plotted
 * coordinate, push the survey mark out to clear air, and run a hairline leader
 * between the two. Purely a layout offset — no coordinate is altered.
 */
const MIN_GAP = 46;
const RADII = [48, 84, 120];
const ANGLES = [0, 26, -26, 52, -52, 90, -90, 128, -128, 154, -154, 180];

const plotted = projects.map((project) => toSvg(project.coords));
const centre = {
  x: plotted.reduce((sum, p) => sum + p.x, 0) / plotted.length,
  y: plotted.reduce((sum, p) => sum + p.y, 0) / plotted.length,
};

const taken: Array<{ x: number; y: number }> = [];
const isClear = (p: { x: number; y: number }) =>
  taken.every((q) => Math.hypot(q.x - p.x, q.y - p.y) >= MIN_GAP);

/* Placed north to south so the fan resolves the same way on every build. */
const pins = [...projects]
  .sort((a, b) => b.coords[1] - a.coords[1])
  .map((project) => {
    const point = toSvg(project.coords);
    let mark = point;

    if (!isClear(point)) {
      // Fan outward, away from the middle of the cluster, shortest leader first.
      const away = (Math.atan2(point.y - centre.y, point.x - centre.x) * 180) / Math.PI;
      const order = [...ANGLES].sort((a, b) => Math.abs(a) - Math.abs(b));
      search: for (const radius of RADII) {
        for (const angle of order) {
          const t = ((away + angle) * Math.PI) / 180;
          mark = {
            x: point.x + Math.cos(t) * radius,
            y: point.y + Math.sin(t) * radius,
          };
          if (isClear(mark)) break search;
        }
      }
    }

    taken.push(mark);
    return {
      project,
      point,
      mark,
      offset: Math.hypot(mark.x - point.x, mark.y - point.y) > 0.5,
      left: (mark.x / VIEW_W) * 100,
      top: (mark.y / VIEW_H) * 100,
    };
  });
---

<section
  data-project-map
  aria-label="Project location map"
  class="bg-iron py-4"
>
  <div class="mx-auto max-w-[86rem] px-5 sm:px-8">
    <div
      class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-steel/25 pb-3"
    >
      <p class="label-mono text-blaze">
        Project locations · Inland Northwest to the Sawtooths
      </p>
      <p class="font-mono text-[0.6875rem] tracking-[0.14em] text-steel">
        {projects.length} PLOTTED
      </p>
    </div>

    {/* minmax(0, …) on every track: without it the map's min-width would push
        the grid column past the viewport on a phone. */}
    <div
      class="mt-4 grid grid-cols-[minmax(0,1fr)] items-start gap-5 lg:grid-cols-[minmax(0,1fr)_20rem]"
    >
      <div class="min-w-0">
        <!-- Map frame. The scroller keeps the survey marks tappable on a phone
             without letting the page itself overflow. -->
        <div class="overflow-x-auto border border-steel/25">
          <div
            class="relative min-w-[36rem]"
            style={`aspect-ratio: ${VIEW_W} / ${VIEW_H}`}
          >
            <svg
              viewBox={`0 0 ${VIEW_W} ${VIEW_H}`}
              class="absolute inset-0 h-full w-full"
              role="img"
              aria-labelledby="project-map-title project-map-desc"
            >
              <title id="project-map-title"
                >Map of North Fork Enterprises project locations across the Inland
                Northwest</title
              >
              <desc id="project-map-desc"
                >A simplified outline of Washington, Oregon and Idaho on a drafting
                grid, with {projects.length} orange survey marks plotting the project
                locations. Most sit in the Idaho panhandle and eastern Washington; one
                sits alone in central Idaho. Every location is listed as a link
                beneath the map.</desc
              >

              <rect width={VIEW_W} height={VIEW_H} class="fill-iron"></rect>

              <g class="stroke-steel/10" stroke-width="0.75">
                {
                  gridLon.map((x) => (
                    <line x1={x.toFixed(1)} y1="0" x2={x.toFixed(1)} y2={VIEW_H} />
                  ))
                }
                {
                  gridLat.map((y) => (
                    <line x1="0" y1={y.toFixed(1)} x2={VIEW_W} y2={y.toFixed(1)} />
                  ))
                }
              </g>

              <g
                class="fill-gunmetal stroke-steel/55"
                stroke-width="1.5"
                stroke-linejoin="round"
              >
                <path d={ring(OREGON)}></path>
                <path d={ring(WASHINGTON)}></path>
                <path d={ring(IDAHO)}></path>
              </g>

              {
                STATE_LABELS.map((label) => {
                  const { x, y } = toSvg(label.at);
                  return (
                    <text
                      x={x.toFixed(0)}
                      y={y.toFixed(0)}
                      class="fill-steel/75 font-mono"
                      font-size="26"
                      letter-spacing="5"
                      text-anchor="middle"
                    >
                      {label.text}
                    </text>
                  );
                })
              }

              <!-- North arrow, sat in the off-sheet margin. -->
              <g class="stroke-steel/50" stroke-width="1.5" fill="none">
                <path d="M 906 104 V 62"></path>
                <path d="M 898 71 L 906 57 L 914 71"></path>
              </g>
              <text
                x="906"
                y="130"
                class="fill-steel/75 font-mono"
                font-size="22"
                letter-spacing="2"
                text-anchor="middle">N</text
              >

              <!-- Leaders from the plotted coordinate out to an offset mark. -->
              <g class="stroke-blaze/45" stroke-width="1">
                {
                  pins
                    .filter((pin) => pin.offset)
                    .map((pin) => (
                      <line
                        x1={pin.point.x.toFixed(1)}
                        y1={pin.point.y.toFixed(1)}
                        x2={pin.mark.x.toFixed(1)}
                        y2={pin.mark.y.toFixed(1)}
                      />
                    ))
                }
              </g>

              <!-- The true plotted coordinates. -->
              <g class="fill-blaze/70">
                {
                  pins.map((pin) => (
                    <circle
                      cx={pin.point.x.toFixed(1)}
                      cy={pin.point.y.toFixed(1)}
                      r="2.4"
                    />
                  ))
                }
              </g>
            </svg>

            {
              pins.map((pin) => (
                <button
                  type="button"
                  data-map-pin
                  {/* Same facet keys the projects index filters the grid by, so
                      a filtered grid and the map cannot disagree on the count. */}
                  data-sector={pin.project.sector}
                  data-owner-type={pin.project.ownerType}
                  aria-expanded="false"
                  aria-controls={`map-card-${pin.project.slug}`}
                  style={`left: ${pin.left.toFixed(3)}%; top: ${pin.top.toFixed(3)}%; translate: -50% -50%;`}
                  class="group absolute z-10 flex h-8 w-8 items-center justify-center text-blaze/85 transition-colors duration-150 hover:text-blaze focus-visible:text-blaze aria-expanded:z-20 aria-expanded:text-blaze sm:h-11 sm:w-11"
                >
                  <span class="sr-only">
                    {pin.project.name} — {pin.project.location}
                  </span>
                  <svg
                    viewBox="0 0 32 32"
                    aria-hidden="true"
                    class="h-6 w-6 group-aria-expanded:stroke-2 sm:h-7 sm:w-7"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                  >
                    <circle cx="16" cy="16" r="6.5" />
                    <path d="M16 1.6 V 7 M16 25 V 30.4 M1.6 16 H 7 M25 16 H 30.4" />
                    <circle
                      cx="16"
                      cy="16"
                      r="2.7"
                      fill="currentColor"
                      stroke="none"
                      class="opacity-0 transition-opacity duration-150 group-hover:opacity-100 group-focus-visible:opacity-100 group-aria-expanded:opacity-100"
                    />
                  </svg>
                </button>
              ))
            }
          </div>
        </div>

        <p class="mt-2.5 max-w-[68ch] font-mono text-[0.6875rem] leading-relaxed text-steel">
          <span class="sm:hidden">Drag the map sideways to pan. </span>Survey
          marks are offset where jobs sit close together; the hairline leader
          runs back to the plotted coordinate.
        </p>
      </div>

      <!-- Readout. Height is reserved so selecting a mark does not shift the
           page, and it tracks alongside a map taller than the viewport. -->
      <div
        aria-live="polite"
        class="relative min-h-[11.5rem] border border-steel/25 bg-gunmetal p-5 lg:sticky lg:top-24"
      >
        <p data-map-empty class="max-w-[46ch] text-sm leading-relaxed text-vellum/70">
          Select a survey mark to read the job card. Every location is listed below
          as well.
        </p>

        <button
          type="button"
          data-map-close
          hidden
          class="absolute right-4 top-4 border border-steel/40 px-2.5 py-1 font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-steel transition-colors duration-150 hover:border-blaze/60 hover:text-blaze"
        >
          Clear
        </button>

        {
          projects.map((project) => (
            <article id={`map-card-${project.slug}`} data-map-card hidden>
              <p class="label-mono text-blaze">{project.sector}</p>
              <h3 class="mt-1.5 max-w-[24ch] font-display text-2xl font-semibold uppercase leading-tight tracking-tight text-vellum">
                {project.name}
              </h3>
              {project.owner && (
                <p class="mt-1 text-sm text-vellum/70">{project.owner}</p>
              )}
              <p class="mt-1 font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-steel">
                {project.location}
              </p>
              <p class="mt-3 max-w-[44ch] font-mono text-sm leading-snug text-blaze">
                {project.headline}
              </p>
              <a
                href={`/projects/${project.slug}`}
                class="redline mt-4 inline-block font-display text-sm font-semibold uppercase tracking-[0.12em] text-blaze transition-[background-size] duration-200 hover:redline-on"
              >
                Open project sheet →
              </a>
            </article>
          ))
        }
      </div>
    </div>

    <!-- Always present: the no-JS path, the screen-reader path, and the way to
         reach a job whose mark sits under another one. -->
    <div class="mt-6 border-t border-steel/25 pt-4">
      <p id="project-map-index" class="label-mono">
        All plotted locations
      </p>
      <ul
        aria-labelledby="project-map-index"
        class="mt-3 grid gap-x-8 gap-y-0.5 sm:grid-cols-2 lg:grid-cols-3"
      >
        {
          projects.map((project) => (
            <li>
              <a
                href={`/projects/${project.slug}`}
                class="group flex flex-wrap items-baseline gap-x-2 py-1.5"
              >
                <span class="font-display text-base font-semibold uppercase tracking-tight text-vellum transition-colors duration-150 group-hover:text-blaze">
                  {project.name}
                </span>
                <span class="font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-steel">
                  {project.location}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script>
  import { motionOK, reveal } from "../scripts/motion";

  const root = document.querySelector<HTMLElement>("[data-project-map]");

  if (root) {
    const pins = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-map-pin]"),
    );
    const cards = Array.from(
      root.querySelectorAll<HTMLElement>("[data-map-card]"),
    );
    const empty = root.querySelector<HTMLElement>("[data-map-empty]");
    const closeButton = root.querySelector<HTMLButtonElement>("[data-map-close]");

    const openPin = () =>
      pins.find((pin) => pin.getAttribute("aria-expanded") === "true");

    /** Back to the placeholder state. Only one card is ever open. */
    function clear() {
      for (const pin of pins) pin.setAttribute("aria-expanded", "false");
      for (const card of cards) card.hidden = true;
      if (empty) empty.hidden = false;
      if (closeButton) closeButton.hidden = true;
    }

    function open(pin: HTMLButtonElement) {
      const card = document.getElementById(
        pin.getAttribute("aria-controls") ?? "",
      );
      if (!card) return;
      clear();
      pin.setAttribute("aria-expanded", "true");
      card.hidden = false;
      if (empty) empty.hidden = true;
      if (closeButton) closeButton.hidden = false;
    }

    for (const pin of pins) {
      // <button> already handles Enter and Space.
      pin.addEventListener("click", () => {
        if (pin.getAttribute("aria-expanded") === "true") clear();
        else open(pin);
      });
    }

    closeButton?.addEventListener("click", () => {
      const current = openPin();
      clear();
      current?.focus();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      const current = openPin();
      if (!current) return;
      clear();
      current.focus();
    });

    // The marks are already drawn; this only subtracts their entrance.
    // Positioning uses the CSS `translate` property, so GSAP owns `transform`
    // outright and centring survives the tween.
    if (motionOK && pins.length) {
      reveal(root.querySelectorAll("[data-map-pin]"), 0.04);
    }
  }
</script>
