---
import { identity, nav } from "../data/company";
---

<header
  class="absolute inset-x-0 top-0 z-30 border-b border-steel/15 bg-gradient-to-b from-iron/80 to-transparent"
>
  <div
    class="mx-auto flex max-w-[86rem] items-center justify-between gap-6 px-5 py-4 sm:px-8"
  >
    <a href="/" class="group flex items-baseline gap-2.5" aria-label={identity.legalName}>
      <span
        class="font-display text-3xl font-bold leading-none tracking-tight text-blaze"
        >{identity.initials}</span
      >
      <span
        class="hidden font-display text-sm font-semibold uppercase leading-none tracking-[0.18em] text-vellum/85 sm:block"
        >North Fork Enterprises</span
      >
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-7 lg:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="redline font-display text-sm font-semibold uppercase tracking-[0.12em] text-vellum/75 transition-[background-size,color] duration-200 hover:redline-on hover:text-vellum focus-visible:text-vellum"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      href={identity.phoneHref}
      class="shrink-0 border border-blaze/70 px-3.5 py-2 font-mono text-xs tracking-tight text-blaze transition-colors duration-200 hover:bg-blaze hover:text-iron sm:px-4 sm:text-sm"
      >{identity.phone}</a
    >
  </div>
</header>
