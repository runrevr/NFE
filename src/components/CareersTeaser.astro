---
import { Image } from "astro:assets";
import crew from "../assets/photos/careers-crew.jpg";
import { openRoles, benefits } from "../data/company";
---

<section id="careers" class="relative isolate overflow-hidden">
  <Image
    src={crew}
    alt="North Fork Enterprises crew in branded hoodies gathered around a new excavator on a snowy jobsite."
    widths={[640, 1280, 1920]}
    sizes="100vw"
    loading="lazy"
    class="absolute inset-0 -z-10 h-full w-full object-cover"
  />
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-r from-iron via-iron/85 to-iron/45"
  >
  </div>

  <div class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8 sm:py-24">
    <div class="max-w-[42rem]">
      <h2
        class="font-display text-[clamp(2.25rem,5.5vw,4rem)] font-bold uppercase leading-[0.92] tracking-tight text-vellum"
      >
        Build where you live.
      </h2>
      <p class="mt-4 max-w-[46ch] text-lg leading-relaxed text-vellum/80">
        Prevailing wage across the Pacific Northwest, full benefits, and work
        you can drive your family past.
      </p>

      <ul class="mt-8 flex flex-wrap gap-2.5">
        {
          openRoles.map((role) => (
            <li class="border border-steel/35 bg-iron/60 px-3.5 py-2 font-mono text-[0.8125rem] tracking-tight text-vellum/90">
              {role}
            </li>
          ))
        }
      </ul>

      <ul
        class="mt-7 grid gap-x-6 gap-y-2 text-[0.9375rem] text-vellum/70 sm:grid-cols-2"
      >
        {
          benefits.map((benefit) => (
            <li class="flex items-baseline gap-2.5">
              <span class="text-blaze" aria-hidden="true">
                ·
              </span>
              {benefit}
            </li>
          ))
        }
      </ul>

      <a
        href="#careers"
        class="mt-9 inline-block bg-blaze px-6 py-3.5 font-display text-base font-semibold uppercase tracking-[0.1em] text-iron transition-colors duration-200 hover:bg-vellum"
        >See open roles</a
      >
    </div>
  </div>
</section>
