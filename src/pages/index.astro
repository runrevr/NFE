---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import CertBar from "../components/CertBar.astro";
import SectorGrid from "../components/SectorGrid.astro";
import ProofSeals from "../components/ProofSeals.astro";
import FeaturedProjects from "../components/FeaturedProjects.astro";
import PlanSheetRamsey from "../components/PlanSheetRamsey.astro";
import ByTheNumbers from "../components/ByTheNumbers.astro";
import PartnerCta from "../components/PartnerCta.astro";
import CareersTeaser from "../components/CareersTeaser.astro";
import TitleBlockFooter from "../components/TitleBlockFooter.astro";
import StationDivider from "../components/StationDivider.astro";
import { identity } from "../data/company";
---

<Base
  title="North Fork Enterprises — Heavy Civil Contractor | Pinehurst, Idaho"
  description={identity.positioning}
>
  <Nav />
  <main id="main">
    <Hero />
    <CertBar />

    <StationDivider station="STA 1+00" label="Capabilities" />
    <SectorGrid />

    <ProofSeals />

    <StationDivider station="STA 2+00" label="Selected work" />
    <FeaturedProjects />

    <StationDivider station="STA 3+00" label="Ramsey Rd — Sheet C-101" />
    <PlanSheetRamsey />

    <ByTheNumbers />
    <PartnerCta />
    <CareersTeaser />
  </main>
  <TitleBlockFooter />
</Base>
