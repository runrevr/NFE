---
/**
 * Project index — every job in `projects`, filterable by sector and owner type.
 *
 * The grid is authored unfiltered: all twelve cards ship in the markup and the
 * filter buttons only subtract. With JS off the buttons are inert and the full
 * sheet index still reads.
 */
import { Image } from "astro:assets";
import Page from "../../layouts/Page.astro";
import ProjectMap from "../../components/ProjectMap.astro";
import { projects, projectSectors, ownerTypes } from "../../data/company";

import i90Photo from "../../assets/photos/featured-i90.jpg";
import ramseyPhoto from "../../assets/photos/featured-ramsey.jpg";
import willowCreekPhoto from "../../assets/photos/featured-willow-creek.jpg";
import sullivanPhoto from "../../assets/photos/sullivan.jpg";
import tribalHousingPhoto from "../../assets/photos/tribal-housing.jpg";

const photos: Record<string, ImageMetadata> = {
  "featured-i90": i90Photo,
  "featured-ramsey": ramseyPhoto,
  "featured-willow-creek": willowCreekPhoto,
  sullivan: sullivanPhoto,
  "tribal-housing": tribalHousingPhoto,
};

const sheetNo = (i: number) => `PR-${String(i + 1).padStart(2, "0")}`;

const cards = projects.map((project, i) => ({
  project,
  sheet: sheetNo(i),
  photo: project.photo ? photos[project.photo] : null,
}));

const facets = [
  { key: "sector", label: "Sector", values: projectSectors },
  { key: "owner", label: "Owner type", values: ownerTypes },
] as const;

const facetButton =
  "border border-steel/30 px-3 py-2 font-display text-sm font-semibold uppercase leading-none tracking-[0.1em] text-vellum/75 transition-colors duration-200 hover:border-blaze/60 hover:text-vellum aria-pressed:border-blaze aria-pressed:bg-blaze aria-pressed:text-iron";
---

<Page
  title={`Selected work — ${projects.length} heavy civil projects | North Fork Enterprises`}
  description={`${projects.length} heavy civil projects across Idaho and Washington — ${projectSectors.join(", ")}. Filter by sector or owner type.`}
  heading="Selected work"
  eyebrow={`Sheets ${sheetNo(0)}–${sheetNo(projects.length - 1)}`}
  intro={`All ${projects.length} jobs — Idaho and Washington, prime and sub, federal to municipal. Filter by sector or owner type; every card opens a plan-sheet page.`}
>
  <section class="bg-iron py-10 sm:py-12">
    <div class="mx-auto max-w-[86rem] px-5 sm:px-8">
      <!-- filter bar -->
      <div
        class="flex flex-col gap-6 border-b border-steel/25 pb-8 lg:flex-row lg:items-start lg:justify-between lg:gap-12"
      >
        <div class="flex flex-col gap-6 sm:flex-row sm:gap-10">
          {
            facets.map((facet) => (
              <div role="group" aria-labelledby={`facet-${facet.key}`}>
                <p id={`facet-${facet.key}`} class="label-mono">
                  {facet.label}
                </p>
                <div class="mt-3 flex flex-wrap gap-2">
                  <button
                    type="button"
                    data-facet={facet.key}
                    data-value="all"
                    aria-pressed="true"
                    class={facetButton}
                  >
                    All
                  </button>
                  {facet.values.map((value) => (
                    <button
                      type="button"
                      data-facet={facet.key}
                      data-value={value}
                      aria-pressed="false"
                      class={facetButton}
                    >
                      {value}
                    </button>
                  ))}
                </div>
              </div>
            ))
          }
        </div>

        <p
          class="shrink-0 border-l-0 border-steel/25 font-mono text-sm tracking-tight text-steel lg:border-l lg:pl-8"
          aria-live="polite"
        >
          <span data-project-count class="text-blaze"
            >{projects.length} projects</span
          >
          <span class="block text-[0.6875rem] uppercase tracking-[0.14em]"
            >of {projects.length} on file</span
          >
        </p>
      </div>

      <!-- grid -->
      <div
        data-project-grid
        class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
      >
        {
          cards.map(({ project, sheet, photo }) => (
            <a
              href={`/projects/${project.slug}`}
              data-project-card=""
              data-sector={project.sector}
              data-owner-type={project.ownerType}
              class="group flex flex-col border border-steel/20 bg-gunmetal transition-colors duration-200 hover:border-blaze/60"
            >
              <div class="relative aspect-[4/3] overflow-hidden bg-gunmetal">
                {photo ? (
                  <Image
                    src={photo}
                    alt={project.alt ?? project.name}
                    widths={[420, 840]}
                    sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 92vw"
                    loading="lazy"
                    class="h-full w-full object-cover"
                  />
                ) : (
                  <div class="flex h-full w-full items-end p-5 pb-8 pr-16">
                    <span
                      aria-hidden="true"
                      class="font-display text-[clamp(1.9rem,7vw,2.6rem)] font-bold uppercase leading-[0.88] tracking-tight text-vellum/45"
                    >
                      {project.sector}
                    </span>
                    <span class="absolute inset-x-5 bottom-5 h-px bg-steel/25" />
                  </div>
                )}

                <span class="absolute left-0 top-0 bg-iron/85 px-2.5 py-1.5 font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-blaze">
                  {project.sector}
                </span>
                <span class="absolute bottom-0 right-0 bg-iron/85 px-2.5 py-1.5 font-mono text-[0.6875rem] tracking-[0.14em] text-steel">
                  {sheet}
                </span>
              </div>

              <div class="flex flex-1 flex-col p-5">
                <h2 class="font-display text-2xl font-semibold uppercase leading-tight tracking-tight text-vellum">
                  {project.name}
                </h2>
                <p class="mt-1.5 text-sm leading-relaxed text-vellum/75">
                  {project.owner ?? "Owner available on request"}
                  <span class="block text-vellum/60">{project.location}</span>
                </p>
                <p class="mt-auto pt-5 font-mono text-sm leading-snug text-blaze">
                  {project.headline}
                </p>
              </div>
            </a>
          ))
        }
      </div>

      <p
        data-project-empty
        hidden
        class="mt-8 border border-steel/25 p-6 font-mono text-sm leading-relaxed text-vellum/75"
      >
        No projects match both filters. Set either facet back to All.
      </p>
    </div>
  </section>

  <ProjectMap />
</Page>

<script>
  /**
   * Progressive enhancement only. The markup ships unfiltered; this subtracts
   * cards and never adds any, so a script failure leaves all twelve visible.
   */
  type FacetKey = "sector" | "owner";

  const state: Record<FacetKey, string> = { sector: "all", owner: "all" };

  const cards = Array.from(
    document.querySelectorAll<HTMLElement>("[data-project-card]"),
  );
  const buttons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-facet]"),
  );
  const countEl = document.querySelector<HTMLElement>("[data-project-count]");
  const emptyEl = document.querySelector<HTMLElement>("[data-project-empty]");

  /* The map sits below the grid and carries the same facet attributes. Without
     this, filtering to Bridges left three cards above twelve pins — two
     different answers to "how many jobs" on one screen. */
  const pins = Array.from(
    document.querySelectorAll<HTMLElement>("[data-map-pin]"),
  );

  const matches = (el: HTMLElement) =>
    (state.sector === "all" || el.dataset.sector === state.sector) &&
    (state.owner === "all" || el.dataset.ownerType === state.owner);

  if (cards.length && buttons.length) {
    const apply = () => {
      let shown = 0;

      for (const card of cards) {
        const visible = matches(card);
        card.hidden = !visible;
        if (visible) shown += 1;
      }

      for (const pin of pins) {
        const visible = matches(pin);
        pin.hidden = !visible;
        // A hidden pin must not keep an open card or stay tabbable.
        if (!visible && pin.getAttribute("aria-expanded") === "true") {
          pin.click();
        }
      }

      if (countEl) {
        countEl.textContent = `${shown} project${shown === 1 ? "" : "s"}`;
      }
      if (emptyEl) emptyEl.hidden = shown > 0;

      for (const button of buttons) {
        const key = button.dataset.facet as FacetKey;
        button.setAttribute(
          "aria-pressed",
          String(state[key] === button.dataset.value),
        );
      }
    };

    for (const button of buttons) {
      button.addEventListener("click", () => {
        const key = button.dataset.facet as FacetKey;
        state[key] = button.dataset.value ?? "all";
        apply();
      });
    }

    apply();
  }
</script>
